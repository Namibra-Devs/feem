# ==============================================================================
# FEEM Initiative Environment Configuration Template
# Copy this file to .env or .env.local to configure your local/production instance
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Forms Service Configuration (Contact, Volunteer, Partnership, Newsletter, Donation)
# ------------------------------------------------------------------------------
# Supports any standard form-handling service (e.g. Formspree, Web3Forms, Formkeep, Getform).
# For Formspree: Create a free account at https://formspree.io, create a form, and paste the endpoint URL:
# Example: https://formspree.io/f/xpzgqxyz
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID_HERE

# Alternatively, if using Web3Forms (https://web3forms.com):
VITE_WEB3FORMS_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 2. Phase 2: Online Donations & Payment Verification (SHIPS DISABLED BY DEFAULT)
# ------------------------------------------------------------------------------
# Feature flag to toggle online donations UI on the /donate page.
# Keep set to false until Phase 2 credentials and serverless webhook are in place.
NEXT_PUBLIC_ENABLE_ONLINE_DONATIONS=false
VITE_ENABLE_ONLINE_DONATIONS=false

# Client-Safe Public Key (e.g., Paystack public key, Flutterwave public key, or Hubtel client key)
# NEVER put secret keys here!
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=pk_test_placeholder_key
VITE_PAYMENT_PUBLIC_KEY=pk_test_placeholder_key

# Serverless Stub Secrets (Used ONLY inside serverless /api/verify-donation handler)
# WARNING: NEVER expose these to frontend client code or commit to source control!
PAYMENT_SECRET_KEY=sk_test_placeholder_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

